# AI
AI_PROVIDER=openai                 # openai | fake  (fake = deterministic test doubles, clearly labelled)
# OPENAI_API_KEY: set in .env only; never commit. Keep any comment on its own line:
# Docker Compose reads `KEY=  # text` with an empty value as the literal text "# text".
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_SPEND_LIMIT_USD=0.50            # hard cap enforced by the app
AI_MAX_RETRIES=3
# Infra
DATABASE_URL=postgresql+psycopg://vault:vault@db:5432/vault
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
STORAGE_DIR=/data/storage
WORKER_CONCURRENCY=2
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Limits & RAG tuning
MAX_UPLOAD_MB=25
MAX_PAGES=300
MAX_FILES_PER_UPLOAD=10
CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8
INSIGHTS_SINGLE_PASS_MAX_TOKENS=60000
# Dev / tests
RUN_LIVE_AI_TESTS=0
DEBUG_PROMPTS=0
